          try { swallow(AdMob.showBanner({ adId: TEST_BANNER, adSize: 'LARGE_BANNER', position: 'TOP_CENTER', margin: 0, isTesting: BANNER_TESTING, npa: npaMode, keywords: adKeywords(), contentUrl: adContentUrl() })
            .then(function () { shown = true; if (overlayOpen()) { paused = true; swallow(AdMob.hideBanner()); } /* reserve happens on bannerAdLoaded (actual fill) → no empty gap */ })
            .catch(function () { /* keep the reserved space — the banner usually persists from a prior page */ })); } catch (e) {}
        }
        /* FOLDABLE/ROTATE: when the display geometry changes (fold↔unfold, rotate), the
           WebView resizes but the banner keeps its OLD margin → it lands on the navbar.
           Re-place it with a freshly-measured margin. Width change distinguishes a
           fold/rotate from the keyboard (handled separately above). */
        var lastW = window.innerWidth, lastH = window.innerHeight, rzT;
        function reposition() { if (immersive) return; try { swallow(AdMob.removeBanner()); } catch (e) {} shown = false; paused = false; showAd(); }  /* keep ads-on; only re-place the native overlay */
        function onResize() {
          var w = window.innerWidth;
          if (Math.abs(w - lastW) < 40) return; // ONLY reposition on WIDTH change (fold/rotate) — not height (keyboard or the ad's own resize), which caused the banner to re-place itself badly
          lastW = w; lastH = window.innerHeight; clearTimeout(rzT); rzT = setTimeout(reposition, 500);
        }
        window.addEventListener('resize', onResize);
        if (window.screen && window.screen.orientation && window.screen.orientation.addEventListener) window.screen.orientation.addEventListener('change', function () { clearTimeout(rzT); rzT = setTimeout(reposition, 450); });
        /* IN-CONTENT MREC (Option 4): a big 300x250 ad shown ONLY where there's genuine empty
           space — the Recent/My Files empty state. It replaces the top banner there (one ad at
           a time = policy-safe). Pages call these; we keep the height OUT of the persisted
           banner height so it never bloats other pages' top space. */
        K.adMrec = function () {
          try { swallow(AdMob.removeBanner()); } catch (e) {}
          shown = false; paused = false; body.classList.remove('ads-on'); body.classList.add('mrec-on'); setAdH(0);
          try { swallow(AdMob.showBanner({ adId: TEST_BANNER, adSize: 'MEDIUM_RECTANGLE', position: 'CENTER', margin: 0, isTesting: BANNER_TESTING, npa: npaMode })); } catch (e) {}
        };
        K.adRestore = function () {
          if (!body.classList.contains('mrec-on')) return;
          body.classList.remove('mrec-on');
          try { swallow(AdMob.removeBanner()); } catch (e) {}
          shown = false; paused = false;
          try { var s = +(localStorage.getItem('sj_adh') || 0); if (!(s >= 100 && s <= 120)) s = 100; setAdH(s); } catch (e) { setAdH(100); }
          showAd();
        };
        showAd();
        /* ===== AUTO-REFRESH — DISPLAY (banner) ads ONLY =====
           Active users open few screens, so ad REQUESTS stay low. Every 45s we request a
           FRESH banner creative into the SAME reserved strip. This is the safe way to lift
           requests/impressions:
             • Display-only — it NEVER triggers an interstitial (no full-screen interrupt).
             • NEVER reloads the page — only the native banner creative swaps, so the user's
               scroll, inputs, PDF reading position, edits and notes are 100% preserved.
             • The reserved strip (--ad-h / .ads-on) stays put, so there is NO layout shift.
           Skipped while the app is backgrounded, a sheet/modal/overlay is open, or the in-
           content MREC mode is active — so we never refresh under an overlay or off-screen.
           It DOES re-request even if the previous request didn't fill: each cycle is a fresh
           fill chance, which is exactly how we lift requests + match rate. 45s respects
           AdMob's 30–120s refresh policy. NOTE: leave "auto-refresh" OFF in the AdMob console
           for this unit — the app drives the refresh here, so enabling both would double-refresh. */
        var BANNER_CFG = K._bannerCfg = { enabled: true, refreshMs: 45000 };  // tunable (also via window.SnapJarKit._bannerCfg)

        /* ===== NO-FILL RETRY (exponential backoff) =====
           A new/unpublished app gets a LOW match rate — most requests come back "no fill"
           (observed: 20%, i.e. 3 fills per 15 requests). Waiting the full refreshMs after a
           failure leaves the user staring at an empty strip for 45s, so we retry quickly
           instead: 10s → 20s → 40s, then hold at 40s. POLICY: AdMob's 30s minimum applies to
           a DISPLAYED banner; a request that never filled showed nothing, so retrying it
           sooner is allowed. The backoff resets the moment a fill lands.
           All the refresh guards apply here too — while blocked (backgrounded, sheet open,
           MREC mode) we re-arm rather than request, so we never burn a request off-screen. */
        var RETRY_MS = [10000, 20000, 40000], retryN = 0, retryT = null, lastReqTs = 0;
        function canRequest() {
          if (!BANNER_CFG.enabled || immersive) return false;
          try { if (document.hidden) return false; } catch (e) {}
          if (paused || overlayOpen()) return false;
          if (body.classList.contains('mrec-on')) return false;
          return true;
        }
        /* Single funnel for BOTH the 45s cycle and the retry timer: an 8s floor keeps the two
           from firing back-to-back and double-requesting (which would inflate request counts
           and drag the match rate down further). */
        function requestAd() {
          var now = +new Date();
          if (now - lastReqTs < 8000) return;
          lastReqTs = now;
          showAd();
        }
        function cancelRetry() { if (retryT) { clearTimeout(retryT); retryT = null; } }
        function scheduleRetry() {
          cancelRetry();
          var wait = RETRY_MS[Math.min(retryN, RETRY_MS.length - 1)];
          retryN++;
          retryT = setTimeout(function () {
            retryT = null;
            if (!canRequest()) { scheduleRetry(); return; }   // blocked → re-arm, don't waste the request
            requestAd();
          }, wait);
        }
        try { if (AdMob.addListener) {
          AdMob.addListener('bannerAdLoaded', function () { retryN = 0; cancelRetry(); });   // filled → back to the calm 45s cadence
          AdMob.addListener('bannerAdFailedToLoad', function () { if (immersive) return; scheduleRetry(); });
        } } catch (e) {}

        setInterval(function () {
          if (!BANNER_CFG.enabled) return;                              // master switch for the auto-requester
          if (immersive) return;
          try { if (document.hidden) return; } catch (e) {}            // app in background → don't waste requests
          if (paused || overlayOpen()) return;                          // a sheet/modal is open → don't refresh under it
          if (body.classList.contains('mrec-on')) return;               // MREC mode has its own ad
          /* Reload IN PLACE: with a banner already shown, showBanner() routes to the plugin's
             updateExistingAdView() which loads a fresh ad into the SAME native AdView. We must
             NOT removeBanner() first — removeBanner async-nulls the native AdView while showBanner
             async-calls loadAd on it → NullPointerException that CRASHES the whole app (this was
             the "app quits" bug). In-place reload is also smoother (no teardown/flicker) and still
             re-requests every cycle even on a prior no-fill. */
          requestAd();   // shared funnel — 8s floor stops this colliding with a pending retry
        }, BANNER_CFG.refreshMs);
      }).catch(function () {});
    })();
  </script>}

