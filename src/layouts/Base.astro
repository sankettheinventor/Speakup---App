  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      function sync(){ btn.textContent = document.documentElement.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙'; }
      sync();
      btn.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        sync();
      });
    })();

    // Products mega menu — click to open, Esc / outside-click to close (keyboard-safe)
    (function () {
      var mb = document.getElementById('megaBtn'), mp = document.getElementById('megaPanel');
      if (!mb || !mp) return;
      function close(){ mp.classList.remove('open'); mb.setAttribute('aria-expanded','false'); }
      mb.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = mp.classList.toggle('open');
        mb.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function (e) {
        if (!mp.contains(e.target) && e.target !== mb) close();
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      mp.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
    })();
  </script>

  <script is:inline>
    // Cookie consent — records the choice and gates non-essential (ad) cookies.
    (function () {
      var KEY = 'snapjar-consent', saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      window.__consent = saved;
      var b = document.getElementById('cookie-banner');
      if (!saved && b) b.hidden = false;
      function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} window.__consent = v; if (b) b.hidden = true; }
      var a = document.getElementById('cb-accept'), d = document.getElementById('cb-decline');
      if (a) a.onclick = function () { set('accepted'); };
      if (d) d.onclick = function () { set('declined'); };
      window.openCookiePrefs = function () { if (b) b.hidden = false; return false; };
    })();
  </script>

  {!IS_APP && (
    <script is:inline>
      {/* Netlify Identity: only load the widget when an invite/recovery token is
         present in the URL (keeps normal page loads fast). It then lets you set a
         password and bounces you to the CMS. Stripped entirely from the app build —
         the app has no CMS/login, so no reference to identity.netlify.com ships. */}
      (function () {
        if (location.hash && /(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(location.hash)) {
          var s = document.createElement('script');
          s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
          s.onload = function () {
            if (!window.netlifyIdentity) return;
            window.netlifyIdentity.on('init', function (user) {
              if (!user) window.netlifyIdentity.on('login', function () { location.href = '/admin/'; });
            });
          };
          document.body.appendChild(s);
        }
      })();
    </script>
  )}

  {!IS_APP && <script is:inline>
    /* ===== Custom select — replaces the un-themeable native OS dropdown popup
       with a styled popover (WEB ONLY). In the APP we use a bottom-sheet picker
       instead (see the sjsel script above) for consistency with the other sheets.
       The native <select> stays the source of
       truth (existing code reads .value / listens for 'change'); we keep it in
       sync. Defensive: any failure leaves the original native select working. */
    (function () {
      var SVG_CHEV = '<svg class="csel-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
      var SVG_TICK = '<svg class="csel-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>';
      var openInst = null;

      function splitLabel(text) {
        // "192 kbps — recommended (music & speech)" -> {title, desc}
        var m = (text || '').split(/\s+[—–-]\s+/);
        if (m.length > 1) return { title: m[0].trim(), desc: m.slice(1).join(' — ').trim() };
        return { title: (text || '').trim(), desc: '' };
      }
      function fillNode(node, parts) {
        var b = document.createElement('b'); b.textContent = parts.title || '—'; node.appendChild(b);
        if (parts.desc) { var s = document.createElement('small'); s.textContent = parts.desc; node.appendChild(s); }
      }

      function enhance(sel) {
        if (sel.__csel || sel.multiple || sel.size > 1 || sel.hasAttribute('data-no-csel')) return;
        sel.__csel = true;

        var wrap = document.createElement('div'); wrap.className = 'csel';
        sel.parentNode.insertBefore(wrap, sel);
        wrap.appendChild(sel);
        sel.classList.add('csel-native');
        sel.setAttribute('tabindex', '-1'); sel.setAttribute('aria-hidden', 'true');

        var btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'csel-btn';
        btn.setAttribute('aria-haspopup', 'listbox'); btn.setAttribute('aria-expanded', 'false');
        var lblEl = (sel.id && document.querySelector('label[for="' + sel.id + '"]')) || sel.closest('label');
        var lblTxt = sel.getAttribute('aria-label') || (lblEl && lblEl.textContent.trim());
        if (lblTxt) btn.setAttribute('aria-label', lblTxt);
        var lblNode = document.createElement('span'); lblNode.className = 'csel-lbl';
        btn.appendChild(lblNode);
        btn.insertAdjacentHTML('beforeend', SVG_CHEV);
        wrap.appendChild(btn);

        var pop = document.createElement('div');
        pop.className = 'csel-pop'; pop.setAttribute('role', 'listbox');
        document.body.appendChild(pop);

        var inst = { sel: sel, btn: btn, pop: pop, active: -1 };

        function syncBtn() {
          var o = sel.options[sel.selectedIndex];
          lblNode.innerHTML = '';
          fillNode(lblNode, splitLabel(o ? o.textContent : ''));
        }

        function buildPop() {
          pop.innerHTML = '';
          for (var i = 0; i < sel.options.length; i++) {
            (function (o, idx) {
              var opt = document.createElement('button');
              opt.type = 'button'; opt.className = 'csel-opt'; opt.setAttribute('role', 'option');
              opt.setAttribute('aria-selected', idx === sel.selectedIndex ? 'true' : 'false');
              var t = document.createElement('span'); t.className = 'csel-opt-txt';
              fillNode(t, splitLabel(o.textContent));
              opt.appendChild(t);
              opt.insertAdjacentHTML('beforeend', SVG_TICK);
              opt.addEventListener('click', function () { pick(idx); });
              opt.addEventListener('mousemove', function () { setActive(idx); });
              pop.appendChild(opt);
            })(sel.options[i], i);
          }
        }
        function setActive(i) {
          var opts = pop.children;
          if (inst.active >= 0 && opts[inst.active]) opts[inst.active].classList.remove('active');
          inst.active = i;
          if (i >= 0 && opts[i]) { opts[i].classList.add('active'); opts[i].scrollIntoView({ block: 'nearest' }); }
        }
        function place() {
          var r = btn.getBoundingClientRect();
          pop.style.width = r.width + 'px';
          pop.style.left = r.left + 'px';
          var h = pop.offsetHeight, gap = 6;
          var below = window.innerHeight - r.bottom, above = r.top;
          if (below < h + gap && above > below) {
            pop.classList.add('up'); pop.style.top = Math.max(gap, r.top - h - gap) + 'px';
          } else {
            pop.classList.remove('up'); pop.style.top = (r.bottom + gap) + 'px';
          }
        }
        function open() {
          if (openInst && openInst !== inst) openInst.close();
          buildPop();
          place();                    // offsetHeight is valid while still at opacity 0
          pop.classList.add('open');  // then animate in from the placed position
          btn.setAttribute('aria-expanded', 'true');
          setActive(sel.selectedIndex);
          openInst = inst;
          window.addEventListener('scroll', onScroll, true);
          window.addEventListener('resize', place);
        }
        function close() {
          pop.classList.remove('open'); btn.setAttribute('aria-expanded', 'false');
          window.removeEventListener('scroll', onScroll, true);
          window.removeEventListener('resize', place);
          if (openInst === inst) openInst = null;
        }
        function onScroll() { place(); }
        function pick(i) {
          if (i !== sel.selectedIndex) {
            sel.selectedIndex = i;
            sel.dispatchEvent(new Event('input', { bubbles: true }));
            sel.dispatchEvent(new Event('change', { bubbles: true }));
          }
          syncBtn(); close(); btn.focus();
        }
        inst.close = close;

        btn.addEventListener('click', function () {
          if (pop.classList.contains('open')) close(); else open();
        });
        btn.addEventListener('keydown', function (e) {
          var isOpen = pop.classList.contains('open');
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            if (!isOpen) { open(); return; }
            var n = pop.children.length, next = inst.active < 0 ? 0 : inst.active + (e.key === 'ArrowDown' ? 1 : -1);
            setActive((next + n) % n);
          } else if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            if (!isOpen) open(); else if (inst.active >= 0) pick(inst.active);
          } else if (e.key === 'Escape') {
            if (isOpen) { e.preventDefault(); close(); }
          } else if (e.key === 'Home' && isOpen) { e.preventDefault(); setActive(0); }
          else if (e.key === 'End' && isOpen) { e.preventDefault(); setActive(pop.children.length - 1); }
        });
        pop.addEventListener('keydown', function (e) { if (e.key === 'Escape') { e.preventDefault(); close(); btn.focus(); } });

        // outside click / native change / dynamic option changes
        document.addEventListener('pointerdown', function (e) {
          if (pop.classList.contains('open') && !pop.contains(e.target) && !btn.contains(e.target)) close();
        });
        sel.addEventListener('change', syncBtn);
        try {
          new MutationObserver(function () { syncBtn(); if (pop.classList.contains('open')) buildPop(); })
            .observe(sel, { childList: true });
        } catch (e) {}

        syncBtn();
      }

      function init() {
        var sels = document.querySelectorAll('select');
        for (var i = 0; i < sels.length; i++) { try { enhance(sels[i]); } catch (e) {} }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>}
{/* NotificationDirector — app only. Loads after SnapJarKit so it can use K.plugin(). */}
{IS_APP && <script is:inline src="/assets/notify.js" defer></script>}
{/* Readability loader. Two constraints force this exact shape:
    1. SnapJarKit lives in an `is:inline` script, where a bare specifier like
       '@mozilla/readability' can never resolve at runtime — so the import must be in a BUNDLED
       script that Astro rewrites at build time.
    2. Astro only bundles <script> tags at template top level; nested inside a {conditional}
       it is left inline, which silently reintroduces problem 1.
    Hence: unconditional and unwrapped. The import stays dynamic, so the parser is fetched only
    when someone actually opens an article link. */}
<script>
  window.__sjLoadReadability = function () {
    return import('@mozilla/readability').then(function (m) { return m.Readability; });
  };
</script>
